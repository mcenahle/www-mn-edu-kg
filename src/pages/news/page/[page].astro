---
import Navbar from "../../../layouts/Navbar.astro";
import Layout from "../../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { news } from "../../../data/news";

export function getStaticPaths() {
  const pageSize = 10;
  const totalPages = Math.ceil(news.length / pageSize);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2;

    return {
      params: {
        page: String(page),
      },
      props: {
        page,
        totalPages,
      },
    };
  });
}

const pageSize = 10;

const { page, totalPages } = Astro.props;

const start = (page - 1) * pageSize;
const posts = news.slice(start, start + pageSize);

const previousUrl = page === 2 ? "/news/" : `/news/page/${page - 1}/`;

const nextUrl = page < totalPages ? `/news/page/${page + 1}/` : null;
---

<Navbar />

<title>新闻列表 - 第 {page} 页 - www.mn.edu.kg</title>

<Layout>
  <div id="container">
    <div class="domain-card bg-white shadow-sm overflow-hidden rounded-3 mb-4">
      <div
        class="domain-card-header py-3 px-4 border-bottom d-flex align-items-center"
      >
        <div class="text-black fs-5 fw-bold">新闻列表</div>
      </div>

      <div class="domain-card-body p-4">
        <ul>
          {
            posts.map((post) => (
              <li class="py-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                  <a href={post.url} title={post.title}>
                    <u>{post.title}</u>&nbsp;
                    <Icon name="mdi:arrow-top-right" />
                  </a>

                  <span class="text-muted rounded-pill">
                    <Icon name="mdi:calendar" /> {post.date}
                  </span>
                </div>
              </li>
            ))
          }
        </ul>

        <nav aria-label="版本列表分页">
          <ul class="pagination justify-content-center mb-0">
            <li class="page-item">
              <a class="page-link" href={previousUrl}> 上一页 </a>
            </li>

            <li class="page-item disabled">
              <span class="page-link">
                {page} / {totalPages}
              </span>
            </li>

            <li class:list={["page-item", { disabled: !nextUrl }]}>
              {
                nextUrl ? (
                  <a class="page-link" href={nextUrl}>
                    下一页
                  </a>
                ) : (
                  <span class="page-link">下一页</span>
                )
              }
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</Layout>

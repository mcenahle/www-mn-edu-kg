---
import Navbar from "../../layouts/Navbar.astro";
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const modules = import.meta.glob("./*.md", { eager: true });

const news = Object.entries(modules)
  .map(([path, module]: any) => {
    const slug = path.replace("./", "").replace(".md", "");

    return {
      title: module.frontmatter.title,
      date: module.frontmatter.date,
      url: `/news/${slug}/`,
    };
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const pageSize = 10;
const posts = news.slice(0, pageSize);
const totalPages = Math.ceil(news.length / pageSize);
---

<Navbar />

<title>新闻列表 - www.mn.edu.kg</title>

<Layout>
  {
    posts.length === 0 ? (
      <p class="text-muted">暂时还没有文章。</p>
    ) : (
      <div id="container">
        <div class="domain-card bg-white shadow-sm overflow-hidden rounded-3 mb-4">
          <div class="domain-card-header py-3 px-4 border-bottom d-flex align-items-center">
            <div class="text-black fs-5 fw-bold">新闻列表</div>
          </div>

          <div class="domain-card-body p-4">
            <ul>
              {posts.map((news) => (
                <li class="py-2">
                  <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <a href={news.url} title={news.title}>
                      <u>{news.title}</u>&nbsp;
                      <Icon name="mdi:arrow-top-right" />
                    </a>

                    <span class="text-muted rounded-pill">
                      <Icon name="mdi:calendar" /> {news.date}
                    </span>
                  </div>
                </li>
              ))}
            </ul>

            {totalPages > 1 && (
              <nav aria-label="版本列表分页">
                <ul class="pagination justify-content-center mb-0">
                  <li class="page-item disabled">
                    <span class="page-link">上一页</span>
                  </li>

                  <li class="page-item disabled">
                    <span class="page-link">1 / {totalPages}</span>
                  </li>

                  <li class="page-item">
                    <a class="page-link" href="/news/page/2/">
                      下一页
                    </a>
                  </li>
                </ul>
              </nav>
            )}
          </div>
        </div>
      </div>
    )
  }
</Layout>

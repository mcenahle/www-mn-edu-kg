---
import { Icon } from "astro-icon/components";
---

<footer>
  <div class="container px-5 py-4">
    <div
      class="row align-items-center justify-content-between flex-column flex-sm-row"
    >
      <div class="col-auto">
        <div class="small m-0">
          © 2026 www.mn.edu.kg & www.shmc.ac.cn. All rights reserved.
        </div>
      </div>
      <div class="col-auto">
        <div class="small m-0">
          <Icon name="mdi:hospital" /> Inspired by <a
            href="https://www.9hospital.com.cn"
            target="_blank"
            rel="noopener noreferrer"
            ><u>Shanghai Ninth People's Hospital</u>&nbsp;
            <Icon name="mdi:open-in-new" /></a
          >.
        </div>
      </div>
    </div>
    <div style="text-align:center;">
      Powered by <Icon name="logos:astro" />.<small style="margin-left: 6px;"
        ><Icon name="mdi:format-font" /> 相关字体服务：<a
          href="https://chinese-font.netlify.app/"
          id="footer-font-support"
          target="_blank"><u>中文网字计划</u> <Icon name="mdi:open-in-new" /></a
        ></small
      >
    </div>
  </div>
</footer>

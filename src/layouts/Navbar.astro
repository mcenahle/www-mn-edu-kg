<div
  class="offcanvas offcanvas-end"
  tabindex="-1"
  id="offcanvasRight"
  aria-labelledby="offcanvasRightLabel"
>
  <div class="offcanvas-header">
    <h5 id="offcanvasRightLabel">www.mn.edu.kg</h5>
    <button
      type="button"
      class="btn-close text-reset"
      data-bs-dismiss="offcanvas"
      aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <h5>本网站相关资源</h5>
    <div class="row g-3">
      <div class="col-6">
        <a href="/news/" class="btn btn-primary w-100" role="button"
          >站点新闻 <Icon name="mdi:arrow-top-right" /></a
        >
      </div>
      <div class="col-6">
        <a
          href="https://www.shm.ac.cn"
          target="_blank"
          class="btn btn-outline-primary w-100"
          role="button">备用网站 <Icon name="mdi:open-in-new" /></a
        >
      </div>
    </div>
    <hr />
    <h5>个人运行的其它网站</h5>
    <ul>
      <li>
        <a href="https://hi.mcenahle.page" target="_blank"
          ><u>个人主页网站</u> <Icon name="mdi:open-in-new" /></a
        >
      </li>
      <li>
        <a href="https://blog.mcenahle.page" target="_blank"
          ><u>博客网站（梅之夏）</u> <Icon name="mdi:open-in-new" /></a
        >
      </li>
    </ul>
    <hr />
    <h5>近期相关</h5>
    <ul>
      <li>
        <a href="https://www.shnu.edu.cn" target="_blank"
          ><u>上海师范大学</u> <Icon name="mdi:open-in-new" /></a
        >
      </li>
    </ul>
  </div>
</div>
